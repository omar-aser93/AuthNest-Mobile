# React-Native/Expo Environment Variables, needs prefix EXPO_PUBLIC_

# The actual backend URL, if you already deployed to "Render" or any other backend hosting service
EXPO_PUBLIC_API_URL=https://authnest-backend-v0ty.onrender.com/api/v1

# The actual frontend URL, if you already deployed to "Vercel" or any other frontend hosting service
EXPO_PUBLIC_FRONTEND_ORIGIN=https://auth-nest-frontend.vercel.app

# Already have this one from the backend, copy the exact value
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=830011831574-mao455gnhidd2dmn4aqpm16i0sg64e70.apps.googleusercontent.com
# created new IOS client in google cloud console, and got this value
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=830011831574-ms7vf31ipc1tpiticdrnb4kkn7oqqi8p.apps.googleusercontent.com

# As for Android GOOGLE CLIENT_ID, We don't need it here, When you are ready to publish your app to Google Play Store, the app will be signed with a different release keystore. u will then need to create another Android OAuth client in the same Google Cloud project. This new client will use the same package name (com.authnest.app) but will have the SHA-1 fingerprint of your release keystore. 


